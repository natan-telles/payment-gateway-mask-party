# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# APP URL (Utilizado para geração de links e callbacks)
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# GATEWAY DE PAGAMENTO PIX
# ==============================================================================
PAYMENT_PROVIDER=infinitepay
# Token secreto anexado à URL do webhook (?token=...). Gere um valor aleatório.
PAYMENT_WEBHOOK_TOKEN=your-random-webhook-token

# InfinitePay: sua InfiniteTag (sem o $)
INFINITEPAY_HANDLE=your-infinite-tag
# INFINITEPAY_API_URL=https://api.checkout.infinitepay.io

# ==============================================================================
# NOTIFICAÇÕES POR E-MAIL (Resend - Grátis até 3.000/mês)
# ==============================================================================
RESEND_API_KEY=re_123456789
EMAIL_FROM=Mask Party <ingressos@seudominio.com.br>

# ==============================================================================
# ADMIN DASHBOARD
# ==============================================================================
ADMIN_PASSWORD=admin123
