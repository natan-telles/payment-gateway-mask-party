# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# APP URL (Utilizado para geração de links e callbacks)
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional: mesma URL lida em runtime (não exige rebuild). Tem prioridade sobre NEXT_PUBLIC_APP_URL.
# APP_URL=https://seudominio.com.br

# ==============================================================================
# GATEWAY DE PAGAMENTO PIX
# ==============================================================================
# infinitepay (checkout hospedado) ou mercadopago (Pix direto no site)
PAYMENT_PROVIDER=mercadopago
# Token secreto anexado à URL do webhook (?token=...). Gere um valor aleatório.
PAYMENT_WEBHOOK_TOKEN=your-random-webhook-token

# InfinitePay: sua InfiniteTag (sem o $)
INFINITEPAY_HANDLE=your-infinite-tag
# INFINITEPAY_API_URL=https://api.checkout.infinitepay.io

# Mercado Pago (Checkout Transparente / API Orders): Access Token de produção
MERCADO_PAGO_ACCESS_TOKEN=your-access-token
# Assinatura secreta gerada em Suas integrações > Webhooks (evento "Order")
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret
# true com credenciais de teste: o pagador vai como "APRO" e o Mercado Pago aprova o Pix sozinho
MERCADO_PAGO_TEST_MODE=false

# ==============================================================================
# NOTIFICAÇÕES POR E-MAIL (Resend - Grátis até 3.000/mês)
# ==============================================================================
RESEND_API_KEY=re_123456789
EMAIL_FROM=Mask Party <ingressos@seudominio.com.br>

# ==============================================================================
# ADMIN DASHBOARD
# ==============================================================================
ADMIN_PASSWORD=admin123
